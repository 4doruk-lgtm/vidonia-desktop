{
  "name": "vidonia-desktop",
  "version": "1.0.0",
  "description": "Vidonia desktop video enhancer",
  "main": "main.js",
  "author": "Vidonia",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vidonia.app",
    "productName": "Vidonia",
    "files": ["main.js", "preload.js", "app/**/*"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
